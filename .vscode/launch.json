{
  "version": "0.2.0",
  "compounds": [
    {
      // FastAPI controller under debugpy (port 8080) and Angular dev server (port 4200, /api
      // proxied to 8080) in Chrome with the TypeScript breakpoints mapped, live reload on save
      "name": "Controller (debug: FastAPI + Angular)",
      "configurations": ["Controller: FastAPI (port 8080)", "Controller: Angular (port 4200)"],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      // dev_reload restarts the controller on each save of src/ (debugged as a subprocess)
      "name": "Controller: FastAPI (port 8080)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev_reload.py",
      "args": ["security-review-controller", "serve", "--host", "127.0.0.1", "--port", "8080"],
      "subProcess": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "SECREVIEW_LOG_LEVEL": "DEBUG"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": { "hidden": true }
    },
    {
      "name": "Controller: Angular (port 4200)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200/ui/",
      "webRoot": "${workspaceFolder}/web",
      "preLaunchTask": "Web UI: dev server (port 4200)",
      "postDebugTask": "Web UI: stop dev server",
      "sourceMaps": true,
      "presentation": { "hidden": true }
    },
    {
      "name": "MCP server (debug, port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "security_review_mcp",
      "args": ["serve", "--transport", "streamable-http", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "SECREVIEW_LOG_LEVEL": "DEBUG"
      },
      "preLaunchTask": "Database upgrade",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Any controller command, e.g. db status, token list, rules list, user list
      // Reset the first admin : security-review-controller user reset-password admin
      "name": "Controller CLI (prompt for arguments)",
      "type": "debugpy",
      "request": "launch",
      "module": "security_review_mcp.controller",
      "args": "${input:controllerArgs}",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Docs: MkDocs (port 8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "mkdocs",
      "args": ["serve", "-a", "127.0.0.1:8001"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Serving on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
