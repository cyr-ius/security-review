{
  "version": "0.2.0",
  "compounds": [
    {
      // Controller (port 8080) and a scan engine (port 8090) that takes its code scans; both
      // read the shared secret SECREVIEW_SCAN_ENGINE_TOKEN from .env (openssl rand -hex 32)
      "name": "Controller + scan engine (debug)",
      "configurations": [
        "Controller: FastAPI (port 8080)",
        "Controller: Angular (port 4200)",
        "MCP server (debug, port 8000)",
        "Scan engine (debug, port 8090)"
      ],
      "stopAll": true
    },
    {
      // FastAPI controller under debugpy (port 8080) and Angular dev server (port 4200, /api
      // proxied to 8080) in Chrome with the TypeScript breakpoints mapped, live reload on save
      "name": "Controller (debug: FastAPI + Angular)",
      "configurations": ["Controller: FastAPI (port 8080)", "Controller: Angular (port 4200)"],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      // dev_reload restarts the controller on each save of src/ (debugged as a subprocess)
      "name": "Controller: FastAPI (port 8080)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev_reload.py",
      "args": ["security-review-controller", "serve", "--host", "127.0.0.1", "--port", "8080"],
      "subProcess": true,
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "SECREVIEW_LOG_LEVEL": "DEBUG",
        "SECREVIEW_OPENGREP_ENABLED": "true",
        "SECREVIEW_OPENGREP_RULES_DIR": "${workspaceFolder}/.venv/var/lib/secreview/rules/opengrep",
        "SECREVIEW_PUBLIC_URL": "http://localhost:8080",
        "SECREVIEW_OSV_AUTO_UPDATE": "true"
      },
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": { "hidden": true }
    },
    {
      "name": "Controller: Angular (port 4200)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200/ui/",
      "webRoot": "${workspaceFolder}/web",
      "preLaunchTask": "Web UI: dev server (port 4200)",
      "postDebugTask": "Web UI: stop dev server",
      "sourceMaps": true,
      "presentation": { "hidden": true }
    },
    {
      "name": "MCP server (debug, port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "security_review_mcp",
      "args": ["serve", "--transport", "streamable-http", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "SECREVIEW_LOG_LEVEL": "DEBUG"
      },
      "preLaunchTask": "Database upgrade",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Scan engine: reads no database, enrolls with the controller on port 8080 (start it first,
      // or the compound above) and copies its rules before each scan. Needs
      // SECREVIEW_SCAN_ENGINE_TOKEN in .env, which also turns the engines on for the controller
      "name": "Scan engine (debug, port 8090)",
      "type": "debugpy",
      "request": "launch",
      "module": "security_review_mcp.engines.worker",
      "args": ["--host", "127.0.0.1", "--port", "8090"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "SECREVIEW_LOG_LEVEL": "DEBUG",
        "SECREVIEW_CONTROLLER_URL": "http://127.0.0.1:8080",
        "SECREVIEW_PUBLIC_URL": "http://127.0.0.1:8080",
        "SECREVIEW_OPENGREP_ENABLED": "true",
        "SECREVIEW_OPENGREP_RULES_DIR": "${workspaceFolder}/.venv/var/lib/secreview/scan-engine/rules/opengrep"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      // Any controller command, e.g. db status, token list, rules list, user list
      // Reset the first admin : security-review-controller user reset-password admin
      "name": "Controller CLI (prompt for arguments)",
      "type": "debugpy",
      "request": "launch",
      "module": "security_review_mcp.controller",
      "args": "${input:controllerArgs}",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Docs: MkDocs (port 8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "mkdocs",
      "args": ["serve", "-a", "127.0.0.1:8001"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Serving on (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "inputs": [
    {
      "id": "controllerArgs",
      "type": "promptString",
      "description": "security-review-controller arguments",
      "default": "user reset-password admin"
    }
  ]
}
