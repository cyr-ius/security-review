{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build security_review",
      "detail": "uv sync --extra dev --extra docs --extra postgres",
      "type": "process",
      "command": "uv",
      "args": ["sync", "--extra", "dev", "--extra", "docs", "--extra", "postgres"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Database upgrade",
      "detail": "security-review-controller db upgrade (the HTTP MCP server never migrates)",
      "type": "process",
      "command": "uv",
      "args": ["run", "security-review-controller", "db", "upgrade"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build security_review",
      "problemMatcher": []
    },
    {
      "label": "Tests",
      "type": "process",
      "command": "uv",
      "args": ["run", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "uv run ruff check . && uv run ruff format --check . && uv run mkdocs build --strict",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Web UI: build",
      "detail": "npm ci && npm run build (served on /ui by the controller)",
      "type": "shell",
      "command": "npm ci && npm run build",
      "options": { "cwd": "${workspaceFolder}/web" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Web UI: dev server (port 4200)",
      "detail": "ng serve, /api proxied to the controller on port 8080",
      // A shell task, not "npm": VS Code merges an npm task with the detected one and can lose
      // its problemMatcher, then refuses to wait for it
      "type": "shell",
      "command": "npm start",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      // Lets a launch configuration wait for the first build (and each rebuild) to finish
      "problemMatcher": {
        "owner": "angular",
        "fileLocation": ["relative", "${workspaceFolder}/web"],
        // VS Code drops a pattern without "file" (then the task has no matcher): match the
        // "    src/app/x.ts:12:5:" location line esbuild prints under each error
        "pattern": {
          "regexp": "^\\s+((?:src|public)/\\S+?):(\\d+):(\\d+):$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 1
        },
        "background": {
          "activeBegin": true,
          // The debugger gives up after 5 s without a begin or end event, and ng serve no longer
          // prints a "Building..." line (only an ANSI spinner): match the "> ng serve" line npm
          // prints at once
          "beginsPattern": "^> ng serve|Building\\.\\.\\.|Changes detected",
          "endsPattern": "Application bundle generation (complete|failed)"
        }
      }
    },
    {
      // postDebugTask of the Angular launch: the Stop button never ends a preLaunchTask
      "label": "Web UI: stop dev server",
      "type": "shell",
      "command": "echo ${input:terminateDevServer}",
      "presentation": { "reveal": "never", "close": true },
      "problemMatcher": []
    },
    {
      "label": "Docker: compose up",
      "detail": "Image test: its own PostgreSQL + migrate + controller (8080) + MCP server (8000); needs POSTGRES_PASSWORD in .env",
      "type": "process",
      "command": "docker",
      "args": ["compose", "up", "-d", "--build"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Docker: compose down",
      "type": "process",
      "command": "docker",
      "args": ["compose", "down"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminateDevServer",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "Web UI: dev server (port 4200)"
    }
  ]
}
