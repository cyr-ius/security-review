// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "security-review-mcp",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
  "features": {
    "ghcr.io/devcontainers-extra/features/prek:1": {},
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    // Dedicated Docker daemon to build and run the project Dockerfile. Preferred over
    // docker-outside-of-docker: the host socket would give tools running here (including AI
    // agents) root access to the host. Docker CE rather than Moby, packaged for Debian trixie.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    }
  },
  // Same ports for the VS Code launch configurations and for docker compose
  "forwardPorts": [8000, 8080, 4200, 8001],
  "portsAttributes": {
    "8000": { "label": "MCP server (/mcp)", "onAutoForward": "notify" },
    "8080": { "label": "Controller (/ui, /api/v1)", "onAutoForward": "notify" },
    "4200": { "label": "Angular dev server", "onAutoForward": "silent" },
    "8001": { "label": "Docs (mkdocs serve)", "onAutoForward": "silent" }
  },
  // Also migrates the local SQLite database, so that the HTTP MCP server can start right away
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && prek install --overwrite && uv sync --extra dev --extra docs --link-mode=copy && uv run security-review-controller db upgrade",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "ms-vscode-remote.remote-containers",
        "streetsidesoftware.code-spell-checker",
        "anthropic.claude-code"
      ],
      "settings": {
        // ── Python ──────────────────────────────────────────────────────
        "python.terminal.activateEnvInCurrentTerminal": true,
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.formatOnPaste": false,
          "editor.formatOnType": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        "ruff.enable": true,
        "ruff.organizeImports": true,
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[yaml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        // ── Général ──────────────────────────────────────────────────────
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true
      }
    }
  },
  "mounts": [
    "source=${env:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${env:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached"
  ]
}
