// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
  "name": "security-review-mcp",
  // Development container (app) and its PostgreSQL database (db): see compose.yaml
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "runServices": ["app", "db"],
  "workspaceFolder": "/workspaces/security-review-mcp",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers-extra/features/prek:1": {},
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/devcontainers/features/node:2.1.1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    }
  },
  // Same ports for the VS Code launch configurations and for docker compose
  "forwardPorts": [8000, 8080, 4200, 8001, "db:5432"],
  "portsAttributes": {
    "db:5432": { "label": "PostgreSQL (secreview / secreview)", "onAutoForward": "silent" },
    "8000": { "label": "MCP server (/mcp)", "onAutoForward": "notify" },
    "8080": { "label": "Controller (/ui, /api/v1)", "onAutoForward": "notify" },
    "4200": { "label": "Angular dev server", "onAutoForward": "silent" },
    "8001": { "label": "Docs (mkdocs serve)", "onAutoForward": "silent" }
  },
  // psql client, PostgreSQL driver (extra postgres), then migration of the db service, so that
  // the HTTP MCP server can start right away
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && sudo apt-get update -qq && sudo apt-get install -y -qq --no-install-recommends postgresql-client && prek install --overwrite && uv sync --extra dev --extra docs --extra postgres --link-mode=copy && uv run security-review-controller db upgrade",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "ms-vscode-remote.remote-containers",
        "streetsidesoftware.code-spell-checker",
        "anthropic.claude-code"
      ],
      "settings": {
        // ── Python ──────────────────────────────────────────────────────
        "python.terminal.activateEnvInCurrentTerminal": true,
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.formatOnPaste": false,
          "editor.formatOnType": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        "ruff.enable": true,
        "ruff.organizeImports": true,
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[yaml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        // ── Général ──────────────────────────────────────────────────────
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true
      }
    }
  }
}
