{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "extra-files": [
        {
          "type": "toml",
          "path": "uv.lock",
          "jsonpath": "$.package[?(@.name.value=='security-review')].version"
        },
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "web/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "web/package-lock.json",
          "jsonpath": "$.packages[''].version"
        }
      ]
    }
  }
}
