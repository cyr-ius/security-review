# Copy to .env and adjust. All variables use the SECREVIEW_ prefix.

# Database (SQLite by default; use PostgreSQL for a shared server)
SECREVIEW_DATABASE_URL=sqlite:///./security_reports.db
# SECREVIEW_DATABASE_URL=postgresql+psycopg2://secreview:change-me@db:5432/secreview  # secreview:ignore GEN-007 placeholder
# docker-compose.yml only: PostgreSQL password, also inserted in the URL (use hex characters)
# POSTGRES_PASSWORD=
SECREVIEW_DATABASE_ECHO=false
# Migrate the schema (Alembic) when the controller, the stdio MCP server or a CLI command starts.
# Set to false when a dedicated job runs `security-review-controller db upgrade` (Kubernetes,
# docker-compose.yml): they then only check the schema. The HTTP MCP server never migrates.
SECREVIEW_DB_AUTO_UPGRADE=true

# MCP server transport: stdio (local host) or streamable-http (shared server / CI).
# HOST and PORT are used by the HTTP MCP server and by the controller (`serve`).
SECREVIEW_TRANSPORT=stdio
SECREVIEW_HOST=127.0.0.1
SECREVIEW_PORT=8000

# Bearer tokens are stored in the database (SHA-256 digests only) and managed with
# `security-review-controller token create|list|revoke`. Roles: mcp (default, MCP server),
# reader (controller, read only), triager (controller + finding status), admin (both).
# The controller creates the web user "admin" with a random password, logged once, at its first
# start while no web user exists (enabled in the Docker image). Manage the web users with
# `security-review-controller user create|list|set-role|reset-password|delete`.
# SECREVIEW_AUTH_BOOTSTRAP_ADMIN=true

# Sessions of the web interface (password and OIDC logins): at least 32 characters, the same on
# every controller replica (random per start when unset), and their lifetime (1 to 24 hours)
# SECREVIEW_SESSION_SECRET=
# SECREVIEW_SESSION_HOURS=8

# Enrollment (HTTP MCP server): a client without a token may request a project token (MCP or
# POST /api/v1/enroll on the MCP server); it works once an administrator approves it on the
# controller (web interface or `token approve`)
SECREVIEW_ENROLLMENT=true

# Optional TLS served by uvicorn (HTTP MCP server and controller; disabled without a certificate)
# SECREVIEW_TLS_CERTFILE=/etc/secreview/tls/cert.pem
# SECREVIEW_TLS_KEYFILE=/etc/secreview/tls/key.pem
# SECREVIEW_TLS_KEYFILE_PASSWORD=
# Mutual TLS: require client certificates signed by this CA
# SECREVIEW_TLS_CLIENT_CA=/etc/secreview/tls/clients-ca.pem
# Without a certificate: serve HTTPS with a self-signed one generated at every start
# SECREVIEW_TLS_SELF_SIGNED=false
# Names and IP addresses the clients use, added to the self-signed certificate
# SECREVIEW_TLS_SELF_SIGNED_HOSTS=192.168.1.1,secreview.lan

# Controller: REST API on /api/v1 and, with WEB_UI, the Angular application on /ui
SECREVIEW_WEB_UI=true
# SECREVIEW_WEB_UI_DIR=/path/to/web/build

# Controller only: OpenID Connect login to the web interface (authorization code + PKCE).
# Register REDIRECT_URI (public URL of /api/v1/auth/oidc/callback) at the identity provider.
# Every SECREVIEW_OIDC_* setting but CAFILE can also be set in the web interface (Rôles SSO),
# where a stored value overrides the variable.
# SECREVIEW_OIDC_ENABLED=false
# SECREVIEW_OIDC_ISSUER=https://sso.example.com/realms/acme
# SECREVIEW_OIDC_CLIENT_ID=security-review
# Empty for a public client (PKCE only)
# SECREVIEW_OIDC_CLIENT_SECRET=
# SECREVIEW_OIDC_REDIRECT_URI=https://secreview.example.com/api/v1/auth/oidc/callback
# SECREVIEW_OIDC_SCOPES=openid profile email
# Claim of the groups or roles (dotted path allowed, e.g. realm_access.roles for Keycloak)
# SECREVIEW_OIDC_ROLES_CLAIM=groups
# Comma-separated groups of each role on every project (highest wins), in addition to the
# role mappings managed in the web interface (Rôles SSO)
# SECREVIEW_OIDC_ADMIN_GROUPS=secreview-admins
# SECREVIEW_OIDC_TRIAGER_GROUPS=secreview-triagers
# SECREVIEW_OIDC_READER_GROUPS=developers,qa
# Group role without a matching group: reader, triager or empty (only the role of the account)
# SECREVIEW_OIDC_DEFAULT_ROLE=
# Claim naming the SSO web user (exact match, no fallback)
# SECREVIEW_OIDC_USERNAME_CLAIM=preferred_username
# Create the SSO web user at its first login (when its groups give it a role); false: an
# administrator creates each SSO user in the web interface (Utilisateurs) first
# SECREVIEW_OIDC_AUTO_CREATE_USERS=false
# SECREVIEW_OIDC_DISPLAY_NAME=SSO
# CA bundle of the identity provider (internal CA); proxy: SECREVIEW_PROXY below
# SECREVIEW_OIDC_CAFILE=

# Language of the review reports (overridden by the report_language argument of the prompts);
# empty: the agent chooses
# SECREVIEW_REPORT_LANGUAGE=French

SECREVIEW_LOG_LEVEL=INFO

# Controller only: HTTP proxy of its outgoing connections (OSV download, SSO provider),
# credentials allowed, never logged; without it HTTPS_PROXY / NO_PROXY apply. NO_PROXY: hosts
# reached directly: domains (with their subdomains), IP addresses, CIDR ranges (only for URLs
# whose host is an IP address), * for every host. Both can be overridden in the web interface
# (Paramètres).
# SECREVIEW_PROXY=http://user:password@proxy.example.com:3128  # secreview:ignore GEN-004 GEN-007 placeholder
# SECREVIEW_NO_PROXY=.corp.example,10.0.0.0/8,fd00::/8

# Controller only: download the OSV advisories (all.zip of each ecosystem) at start-up when the
# database is older than the interval, then every interval.
# SECREVIEW_OSV_AUTO_UPDATE=false
# SECREVIEW_OSV_UPDATE_INTERVAL_HOURS=24
# SECREVIEW_OSV_URL=https://osv-vulnerabilities.storage.googleapis.com
# SECREVIEW_OSV_ECOSYSTEMS=PyPI,npm,Maven
# CA bundle used instead of the system one (internal mirror, TLS-inspecting proxy)
# SECREVIEW_OSV_CAFILE=/etc/secreview/proxy-ca.pem
# SECREVIEW_OSV_MAX_DOWNLOAD_MB=1024

# Internal rules are stored in the database: `security-review-controller rules import|export|...`

# Limits
SECREVIEW_MAX_CONTENT_CHARS=200000
SECREVIEW_MAX_FINDINGS_PER_REPORT=500
SECREVIEW_MAX_LIST_LIMIT=100
