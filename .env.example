# Copy to .env and adjust. All variables use the SECREVIEW_ prefix.

# Database (SQLite by default; use PostgreSQL for a shared server)
SECREVIEW_DATABASE_URL=sqlite:///./security_reports.db
# SECREVIEW_DATABASE_URL=postgresql+psycopg2://secreview:change-me@db:5432/secreview
# docker-compose.yml only: PostgreSQL password, also inserted in the URL (use hex characters)
# POSTGRES_PASSWORD=
SECREVIEW_DATABASE_ECHO=false

# Transport: stdio (local host) or streamable-http (shared server / CI)
SECREVIEW_TRANSPORT=stdio
SECREVIEW_HOST=127.0.0.1
SECREVIEW_PORT=8000

# Built-in bearer authentication (streamable-http only; disabled when empty).
# Entries "[label[:role]:]token" or "[label[:role]:]sha256:<hex>", generated by
# `security-review-mcp token --label <name> --role <role>`. Roles: mcp (default, MCP endpoint),
# reader (web interface, read only), triager (web interface + finding status), admin (both)
# SECREVIEW_AUTH_TOKENS=ci:sha256:<hex>,alice:triager:sha256:<hex>
# SECREVIEW_AUTH_TOKENS_FILE=/run/secrets/secreview-tokens
# Optional one-time web-admin password file (enabled by default in the Docker image)
# Optional one-time admin password file (enabled by default in the Docker image)
# SECREVIEW_AUTH_BOOTSTRAP_FILE=/data/admin-token
# Project-token hashes are stored in this file, not in the database
# SECREVIEW_AUTH_MANAGED_TOKENS_FILE=/data/project-tokens.json

# Optional TLS served by uvicorn (streamable-http only; disabled without a certificate)
# SECREVIEW_TLS_CERTFILE=/etc/secreview/tls/cert.pem
# SECREVIEW_TLS_KEYFILE=/etc/secreview/tls/key.pem
# SECREVIEW_TLS_KEYFILE_PASSWORD=
# Mutual TLS: require client certificates signed by this CA
# SECREVIEW_TLS_CLIENT_CA=/etc/secreview/tls/clients-ca.pem

# Web interface (streamable-http only): REST API on /api/v1, Angular application on /ui
SECREVIEW_WEB_UI=true
# SECREVIEW_WEB_UI_DIR=/path/to/web/build

SECREVIEW_LOG_LEVEL=INFO

# Internal rule packs (*.toml), writable by administrators only
# SECREVIEW_RULES_DIR=/etc/security-review-mcp/rules.d

# Limits
SECREVIEW_MAX_CONTENT_CHARS=200000
SECREVIEW_MAX_FINDINGS_PER_REPORT=500
SECREVIEW_MAX_LIST_LIMIT=100
