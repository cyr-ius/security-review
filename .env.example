# Copy to .env and adjust. All variables use the SECREVIEW_ prefix.

# Database (by default a SQLite file of the user: ~/.local/share/security-review-mcp/security_reports.db,
# or under $XDG_DATA_HOME; use PostgreSQL for a shared server)
# SECREVIEW_DATABASE_URL=sqlite:////var/lib/secreview/security_reports.db
# SECREVIEW_DATABASE_URL=postgresql+psycopg2://secreview:change-me@db:5432/secreview  # secreview:ignore GEN-007 placeholder
# docker-compose.yml only: PostgreSQL password, also inserted in the URL (use hex characters)
# POSTGRES_PASSWORD=
# docker-compose.yml only: host address on which the MCP server and the controller are published
# (default 127.0.0.1; 0.0.0.0: every interface, enable TLS first)
# DOCKER_PUBLISH_ADDRESS=127.0.0.1
# docker-compose.yml only: host ports of the MCP server and of the controller
# DOCKER_MCP_PORT=8000
# DOCKER_CONTROLLER_PORT=8080
SECREVIEW_DATABASE_ECHO=false
# Migrate the schema (Alembic) when the controller, the stdio MCP server or a CLI command starts.
# Set to false when a dedicated job runs `security-review-controller db upgrade` (Kubernetes,
# docker-compose.yml): they then only check the schema. The HTTP MCP server never migrates.
SECREVIEW_DB_AUTO_UPGRADE=true

# MCP server transport: stdio (local host) or streamable-http (shared server / CI).
# HOST and PORT are used by the HTTP MCP server and by the controller (`serve`).
SECREVIEW_TRANSPORT=stdio
SECREVIEW_HOST=127.0.0.1
SECREVIEW_PORT=8000

# Bearer tokens are stored in the database (SHA-256 digests only) and managed with
# `security-review-controller token create|list|revoke`. Tokens are for machines; roles: mcp
# (default, MCP server), admin (MCP server and controller), ci (pipeline routes of the
# controller only, always restricted with --project), metrics (Prometheus endpoint only).
# A person reads and triages in the web interface with a web user and its groups; api tokens
# (REST API, Swagger: personal or with a role) are created in the web interface.
# At its first start, while no web user exists, the controller creates the local administrator
# SECREVIEW_ADMIN_USERNAME with a random password, never logged: the only way to a password is
# `security-review-controller user reset-password admin`, which prints it once (to change at
# the first login). Manage the web users with `security-review-controller user create|list|
# set-groups|reset-password|delete`.
# SECREVIEW_ADMIN_USERNAME=admin

# HTTP MCP server: while no token exists, it refuses every client except enrollments,
# unless it listens on localhost. This opens it anyway: only for tests on an isolated network.
# SECREVIEW_ALLOW_UNAUTHENTICATED=false

# Sessions of the web interface (password and OIDC logins): at least 32 characters, the same on
# every controller replica, and their lifetime (1 to 24 hours). Unset, a random secret is drawn
# at every start: sessions end when the controller restarts and are not shared between replicas
# SECREVIEW_SECRET_KEY=
# SECREVIEW_SESSION_HOURS=8

# Enrollment (HTTP MCP server): a client without a token may request its project (MCP or
# POST /api/v1/enroll on the MCP server); a user with projects.create approves it on the
# controller (Projects screen or `project approve`), otherwise it is deleted after
# SECREVIEW_PROJECT_ENROLLMENT_TTL_DAYS. No token is created: the user signs in to the web
# interface and creates a personal MCP token there
SECREVIEW_ENROLLMENT=true
# SECREVIEW_PROJECT_ENROLLMENT_TTL_DAYS=7
# Public URL of the web interface, given by the MCP server to the clients without a valid token
# (enrollment answer, 401 on /mcp) so that the user knows where to create a personal MCP token
# SECREVIEW_WEB_URL=https://secreview.example.com/ui

# Pipeline client (`security-review-ci`): URL of the controller and ci token. Read from the
# environment of the job only (security-review-ci ignores this file).
# SECREVIEW_CONTROLLER_URL=https://secreview.example.com
# SECREVIEW_TOKEN=

# Optional TLS served by uvicorn (HTTP MCP server and controller; disabled without a certificate)
# SECREVIEW_TLS_CERTFILE=/etc/secreview/tls/cert.pem
# SECREVIEW_TLS_KEYFILE=/etc/secreview/tls/key.pem
# SECREVIEW_TLS_KEYFILE_PASSWORD=
# Mutual TLS: require client certificates signed by this CA
# SECREVIEW_TLS_CLIENT_CA=/etc/secreview/tls/clients-ca.pem

# Reverse proxies whose X-Forwarded-For gives the client address (comma-separated IP addresses
# or CIDR ranges, "*" for any): login throttling, enrollment limits and logs. Unset: uvicorn's
# default (FORWARDED_ALLOW_IPS, else 127.0.0.1)
# SECREVIEW_FORWARDED_ALLOW_IPS=10.0.0.0/8

# Controller only: requests of each client address to the REST API per window (429 over the
# limit), counted in the database and shared by every replica; stricter on the login routes
SECREVIEW_RATE_LIMIT_ENABLED=true
SECREVIEW_RATE_LIMIT_WINDOW_SECONDS=60
SECREVIEW_RATE_LIMIT_MAX_REQUESTS=600
SECREVIEW_RATE_LIMIT_AUTH_MAX_REQUESTS=30

# Controller: REST API on /api/v1 and, with WEB_UI, the Angular application on /ui
SECREVIEW_WEB_UI=true
# SECREVIEW_WEB_UI_DIR=/path/to/web/build
# Swagger documentation (/api/docs) and OpenAPI schema (/api/openapi.json), disabled by default
# SECREVIEW_SWAGGER_ENABLED=false

# Controller only: OpenID Connect login to the web interface (authorization code + PKCE).
# Register REDIRECT_URI (public URL of /api/v1/auth/oidc/callback) at the identity provider.
# Every SECREVIEW_OIDC_* setting but CAFILE can also be set in the web interface (OIDC); a
# variable that is set takes precedence over the stored value.
# SECREVIEW_OIDC_ENABLED=false
# SECREVIEW_OIDC_ISSUER=https://sso.example.com/realms/acme
# SECREVIEW_OIDC_CLIENT_ID=security-review
# Empty for a public client (PKCE only)
# SECREVIEW_OIDC_CLIENT_SECRET=
# SECREVIEW_OIDC_REDIRECT_URI=https://secreview.example.com/api/v1/auth/oidc/callback
# SECREVIEW_OIDC_SCOPE=openid profile email
# Claim of the groups or roles (dotted path allowed, e.g. realm_access.roles for Keycloak)
# SECREVIEW_OIDC_ROLES_CLAIM=groups
# Its values are matched against the names of the groups open to OIDC (web interface: Groups)
# Comma-separated OIDC groups created with the admin role at the first login of a member
# SECREVIEW_OIDC_ADMIN_GROUPS=secreview-admins
# Group every OIDC user joins at each login (empty: none)
# SECREVIEW_OIDC_DEFAULT_GROUP=
# Claim naming the OIDC web user (exact match, no fallback)
# SECREVIEW_OIDC_USERNAME_CLAIM=preferred_username
# Create the OIDC web user at its first login (when its groups give it a role); false: an
# administrator creates each OIDC user in the web interface (Utilisateurs) first
# SECREVIEW_OIDC_AUTO_CREATE_USERS=false
# SECREVIEW_OIDC_DISPLAY_NAME=OIDC
# CA bundle of the identity provider (internal CA); proxy: HTTPS_PROXY below
# SECREVIEW_OIDC_CAFILE=
# With OIDC enabled, refuse the password login of the local web users (a variable only: unset
# it if the identity provider is unavailable)
# SECREVIEW_OIDC_ONLY=false

# Language of the review reports (overridden by the report_language argument of the prompts);
# empty: the agent chooses. When set (even empty), takes precedence over the web interface.
# SECREVIEW_REPORT_LANGUAGE=French

# Controller only: delete the reports without findings older than this number of days (at
# start-up, then every day); the latest report of each project is kept. 0 keeps every report.
# SECREVIEW_EMPTY_REPORT_RETENTION_DAYS=90

# Controller only: longest validity in days of an "accepted" or "false_positive" decision; once
# expired, the finding counts as open again (gate, posture)
# SECREVIEW_MAX_DISMISSAL_DAYS=365

# Controller only: a person may accept a risk without an expiry date ("No expiry" in the web
# interface). false: every acceptance needs an expiry date (a false positive never does)
# SECREVIEW_PERMANENT_ACCEPTANCE_ENABLED=true

# Controller only: lowest severity (critical, high, medium, low, info) whose risk acceptance
# needs a reason and an expiry date; a less severe finding is accepted by a plain validation.
# Empty: every acceptance needs them
# SECREVIEW_RISK_ACCEPTANCE_MIN_SEVERITY=medium

# Longest validity in days of a bearer token created or rotated (CLI, web interface),
# also its default validity. 0: tokens do not expire unless a validity is asked for
# SECREVIEW_TOKEN_MAX_DAYS=0

# Controller only: personal tokens a web user may hold of each kind (REST API, MCP), from 1 to 10
# SECREVIEW_PERSONAL_TOKENS_PER_USER=1

# Controller only: delete the audit events older than this many days (0 keeps them all)
# SECREVIEW_AUDIT_RETENTION_DAYS=365
# Keep at most this many audit events (the oldest are deleted by the same purge); 0: no limit
# SECREVIEW_AUDIT_MAX_EVENTS=0
# Send the audit events to syslog: udp://host:port, tcp://host:port, tls://host:port (RFC 5425,
# port 6514 by default) or unix:///dev/log (no proxy). Disabled when unset. When unset, both can
# be set on the Audit log page of the web interface; when set, they take precedence over it.
# SECREVIEW_AUDIT_SYSLOG_ADDRESS=udp://syslog.example.com:514
# SECREVIEW_AUDIT_SYSLOG_FACILITY=local0
# CA bundle that verifies the certificate of a tls:// server (default: the system CA bundle)
# SECREVIEW_AUDIT_SYSLOG_CAFILE=/etc/ssl/certs/internal-ca.pem

# Controller only: Prometheus metrics on /metrics (token of role "metrics" or "admin")
# SECREVIEW_METRICS_ENABLED=true

# Controller: the About page searches GitHub for a newer release (HTTPS, through the outgoing
# proxy, cached 6 hours). Disabled by default: an outgoing connection.
# SECREVIEW_UPDATE_CHECK_ENABLED=false

# Controller only: send findings through connectors (tickets in Jira and ServiceNow, records of
# a third-party connector), by hand from the web interface or automatically every
# CONNECTORS_INTERVAL_SECONDS for the projects given a severity threshold. Outgoing connections
# (HTTPS only, through the outgoing proxy): every connector is off until switched on in the
# Connectors screen. CONNECTORS_ENABLED is the lock of the operator: false locks every connector
# off. CONNECTORS_CAFILE replaces the system CA bundle (internal authority).
# SECREVIEW_CONNECTORS_ENABLED=true
# SECREVIEW_CONNECTORS_INTERVAL_SECONDS=300
# SECREVIEW_CONNECTORS_CAFILE=
# Third-party connectors allowed (entry point names of the group security_review_mcp.connectors,
# comma separated): one installed but not listed is never loaded. Their fields are read from
# SECREVIEW_<KIND>_<FIELD> (SECREVIEW_ACME_API_KEY...).
# SECREVIEW_CONNECTORS_PLUGINS=
# Jira connection (each one can also be set on the Connectors screen; a variable takes
# precedence). Cloud: account e-mail + API token. Empty username: Data Center personal token.
# SECREVIEW_JIRA_URL=https://acme.atlassian.net
# SECREVIEW_JIRA_USERNAME=
# SECREVIEW_JIRA_API_TOKEN=
# SECREVIEW_JIRA_ISSUE_TYPE=Bug
# ServiceNow connection (basic authentication) and table of the records
# SECREVIEW_SERVICENOW_URL=https://acme.service-now.com
# SECREVIEW_SERVICENOW_USERNAME=
# SECREVIEW_SERVICENOW_PASSWORD=
# SECREVIEW_SERVICENOW_TABLE=incident

SECREVIEW_LOG_LEVEL=INFO

# Controller only: HTTP proxy of its outgoing connections (OSV download, OIDC provider), read
# from the standard variables (no SECREVIEW_ prefix): HTTPS_PROXY, else HTTP_PROXY, credentials
# allowed, never logged. NO_PROXY: hosts reached directly: domains (with their subdomains), IP
# addresses (only for URLs whose host is that address; no CIDR ranges), * for every host. When
# not set, both can be set in the web interface (Outgoing proxy); when set, they take precedence.
# HTTPS_PROXY=http://user:password@proxy.example.com:3128  # secreview:ignore GEN-004 GEN-007 placeholder
# HTTP_PROXY=http://user:password@proxy.example.com:3128  # secreview:ignore GEN-004 GEN-007 placeholder
# NO_PROXY=.corp.example,10.0.0.5

# Controller only: download the OSV advisories (all.zip of each ecosystem) at start-up when the
# database is older than the interval, then every interval.
# SECREVIEW_OSV_AUTO_UPDATE=false
# SECREVIEW_OSV_UPDATE_INTERVAL_HOURS=24
# SECREVIEW_OSV_URL=https://osv-vulnerabilities.storage.googleapis.com
# SECREVIEW_OSV_ECOSYSTEMS=PyPI,npm,Maven,Go,crates.io,NuGet
# CA bundle used instead of the system one (internal mirror, TLS-inspecting proxy)
# SECREVIEW_OSV_CAFILE=/etc/secreview/proxy-ca.pem
# SECREVIEW_OSV_MAX_DOWNLOAD_MB=1024

# Internal rules are stored in the database: `security-review-controller rules import|export|...`

# Limits
SECREVIEW_MAX_CONTENT_CHARS=200000
SECREVIEW_MAX_FINDINGS_PER_REPORT=500
SECREVIEW_MAX_LIST_LIMIT=100
# MCP server only: size in MiB of a request of an authenticated MCP client (413 above); a
# client without a token (enrollment server) is bounded to 64 KiB
# SECREVIEW_MAX_MCP_REQUEST_MB=16
# Controller only: scans sent by security-review-ci scan-code / scan-deps (request size in MiB,
# files per request, size of one scanned source file)
# SECREVIEW_MAX_SCAN_REQUEST_MB=64
# SECREVIEW_MAX_SCAN_FILES=10000
# SECREVIEW_MAX_SCAN_FILE_CHARS=1048576
